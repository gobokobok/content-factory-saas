# Content Factory — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.
# See ENV.md for full descriptions of each variable.

# --- Core ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Google Drive ---
# Base64-encoded service account JSON. See DECISIONS.md D015 for encoding instructions.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Drive folder ID of the environment root folder
GOOGLE_DRIVE_ROOT_ID=

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
# Optional: override default model
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Pexels ---
PEXELS_API_KEY=

# --- Replicate ---
REPLICATE_API_TOKEN=
# Optional overrides
# REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell
# REPLICATE_POLL_INTERVAL_SECONDS=3
# REPLICATE_MAX_POLL_ATTEMPTS=60

# --- Freesound ---
FREESOUND_API_KEY=

# --- Pipeline config (optional) ---
# PEXELS_PER_PAGE=5
