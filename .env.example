# Content Factory — Environment Variables
# Copy to .env.local for local development. Never commit .env.local.
# See ENV.md for full descriptions of each variable.

# --- Core ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=content-factory-dev

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
# Optional: override default model
# CLAUDE_MODEL=claude-sonnet-4-6

# --- Pexels ---
PEXELS_API_KEY=

# --- Replicate ---
REPLICATE_API_TOKEN=
# Optional overrides
# REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell
# REPLICATE_POLL_INTERVAL_SECONDS=3
# REPLICATE_MAX_POLL_ATTEMPTS=60

# --- Freesound ---
FREESOUND_API_KEY=

# --- Pipeline config (optional) ---
# PEXELS_PER_PAGE=5
# FFMPEG_TIMEOUT_SECONDS=300

# --- Platform v2 (P2+) ---
# Railway Postgres connection string for cf_platform's metadata index (D048).
# Optional/empty: a missing or unreachable database reports "unavailable" via
# /platform/health and does not affect the legacy app.
# DATABASE_URL=

# --- Platform v2 (P3+) ---
# Telegram trigger interface (D049). Optional/empty: an unset TELEGRAM_WEBHOOK_SECRET
# causes /platform/telegram/webhook to reject all calls with 401, without affecting
# the legacy app.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Comma-separated Telegram chat ids allowed to trigger replies. Empty = unrestricted.
# Temporary single-operator allowlist ahead of S19 multi-tenant auth.
# TELEGRAM_ALLOWED_CHAT_IDS=

# Discovery worker source adapters (D050). Optional/empty: a missing credential
# degrades that one source adapter to an error trace event (partial-failure
# isolation) rather than failing the worker. GoogleTrendsAdapter needs no
# credentials (raw httpx against the public, unofficial Trends API).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=
# YOUTUBE_API_KEY=
